[Unit]
Description=QEMU bridge helper socket

[Socket]
ListenStream=/run/qemu-bridge-helper/qemu-bridge-helper.sock
Symlinks=/run/varlink/registry/website.soss.QemuBridgeHelper
SocketMode=0666
FileDescriptorName=varlink
Accept=yes
MaxConnectionsPerSource=16

[Install]
WantedBy=sockets.target
